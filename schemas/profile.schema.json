{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Onmaynec/SysDiff/schemas/profile.schema.json",
  "title": "Профиль снимка SysDiff",
  "type": "object",
  "required": ["name", "providers"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "description": { "type": "string" },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean" },
          "roots": {
            "type": "array",
            "items": { "type": "string" }
          },
          "exclude": {
            "type": "array",
            "items": { "type": "string" }
          },
          "hashMode": {
            "enum": ["None", "MetadataOnly", "Smart", "Full"]
          },
          "maximumDepth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 256
          },
          "maximumArtifacts": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
