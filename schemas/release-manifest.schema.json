{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Onmaynec/SysDiff/schemas/release-manifest.schema.json",
  "title": "SysDiff release manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "product",
    "version",
    "channel",
    "runtime",
    "tag",
    "assetName",
    "assetUrl",
    "sha256",
    "sizeBytes",
    "minimumUpdaterVersion",
    "publishedAtUtc",
    "unsigned"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "SysDiff" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "channel": { "const": "stable" },
    "runtime": { "const": "win-x64" },
    "tag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "assetName": {
      "type": "string",
      "pattern": "^SysDiff-(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-win-x64\\.zip$"
    },
    "assetUrl": {
      "type": "string",
      "pattern": "^https://github\\.com/Onmaynec/SysDiff/releases/download/v[0-9]+\\.[0-9]+\\.[0-9]+/SysDiff-[0-9]+\\.[0-9]+\\.[0-9]+-win-x64\\.zip$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 536870912
    },
    "minimumUpdaterVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "publishedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "unsigned": { "type": "boolean" }
  },
  "additionalProperties": false
}
